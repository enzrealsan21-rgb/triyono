# Salin file ini menjadi .env, lalu isi nilainya.
PORT=3000
NODE_ENV=development
SESSION_SECRET=ganti-dengan-random-string-panjang-minimal-32-karakter

# API key disimpan di server, JANGAN ditaruh di file frontend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Akun admin pertama dibuat otomatis saat server pertama kali dijalankan.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ganti-password-admin-yang-kuat
